struct Ray {
    vec3 o;
    vec3 d;
    vec3 col;
};

struct SurfaceInteraction {
    vec3 p;
    vec3 ng;
    vec3 ns;
    vec3 dpdu;
    vec3 dpdv;
    mat3 localToWorld;
    mat3 worldToLocal;
    vec2 bary;
    vec2 uv;
