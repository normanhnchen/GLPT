{   
    "file_paths": {
        "ai_training_scenes": "src/assets/models/ai_training/",
        "scene": "src/assets/models/dragon_scene.glb",
        "ai_training_hdris": "src/assets/hdris/ai_training/",
        "hdri": "src/assets/hdris/day_sky_hdri.exr",
        "ai_training_renders": "src/assets/renders/ai_training",
        "renders": "src/assets/renders/images",
        "camera_capture_states": "src/camera_capture_states.json",
        "denoiser_checkpoint": "src/denoiser/checkpoint.pt",
        "denoiser_last_checkpoint": "src/denoiser/last_checkpoint.pt",
        
        "path_tracing": {
            "vert": "src/shaders/path_tracing/final.vs",
            "frag": "src/shaders/path_tracing/final.fs",
            "comp": "src/shaders/path_tracing/path_trace.comp"
        },
        "rasterization": {
            "pbr": {
                "vert": "src/shaders/rasterization/pbr.vs",
                "frag": "src/shaders/rasterization/pbr.fs"
            },
            "background": {
                "vert": "src/shaders/rasterization/background.vs",
                "frag": "src/shaders/rasterization/background.fs"
            },
            "final": {
                "vert": "src/shaders/rasterization/final.vs",
                "frag": "src/shaders/rasterization/final.fs"
            }
        },
        "cache": {
            "scene": "src/assets/cache/",
            "bvh": "src/assets/cache/"
        }
    },
    "screen": {
        "width": 1920,
        "height": 1080,
        "vsync": false,
        "fps_cap": -1
    },
    "camera": {
        "_yaw": 90,
        "_pitch": 0,
        "movement_speed": 5,
        "mouse_sensitivity": 0.1,
        "fov": 45,
        "pos": [0, 0, 0],
        "_front": [0, 0, -1],
        "_up": [0, 1, 0],
        "_world_up": [0, 1, 0]
    },
    "path_tracing": {
        "samples_per_pixel": 1,
        "max_samples": 4096,
        "total_bounces": 8,
        "diffuse_bounces": 4,
        "specular_bounces": 4,
        "transmission_bounces": 8,
        "specular_mode": 0,
        "geometry_mode": 0,
        "transmission_mode": 0,
        "mis_mode": 0
    },
    "post_processing": {
        "blur": 1.0,
        "aperture": 0.0,
        "focus_dist": 10,
        "auto_focus": 0,
        "exposure": 3.0,
        "tonemap": "AgX",
        "hdri_exposure": 1.0
    },
    "render": {
        "render_mode": "rasterization",
        "texture_size": [1024, 1024],
        "tiles_x": 4,
        "tiles_y": 2
    },
    "ai_training": {
        "ai_training_mode": true,
        "camera_setup_mode": false
    }
